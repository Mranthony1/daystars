# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on the site only when set. Leave blank rather than inventing details.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_FACEBOOK=

# Used when you replace the qualitative budget options with approved ranges.
NEXT_PUBLIC_CURRENCY=GHS

# Optional https URL for a real scheduling tool. Hidden when empty.
NEXT_PUBLIC_SCHEDULING_URL=

# Optional analytics. Only "plausible" is supported, and only when both are set.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Server-only email delivery. All three are required before the form reports success.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
